# FinPredict MongoDB Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Local MongoDB: mongodb://localhost:27017/finpredict_db
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/finpredict_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/finpredict_db

# JWT Secret for Session Signatures (Change in production!)
JWT_SECRET=finpredict_institutional_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d
